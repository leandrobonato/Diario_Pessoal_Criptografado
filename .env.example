# =============================================================================
# Diário Pessoal Criptografado — variáveis de ambiente
#
# Copie para .env e preencha. O .env está no .gitignore e NUNCA deve ser
# versionado.
#
#     cp .env.example .env        (Linux/Mac)
#     copy .env.example .env      (Windows)
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — encontre em Project Settings → API
# -----------------------------------------------------------------------------
# URL do projeto, algo como https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Chave "anon / public". É pública por definição e SEGURA de usar no cliente:
# sozinha ela não abre nenhuma linha, porque o RLS exige um JWT de usuário.
SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# ⚠️  NUNCA coloque a service_role key aqui.
#
# A service_role tem BYPASSRLS: ela ignora TODAS as policies deste projeto.
# Ela existe para jobs administrativos no servidor, jamais para o app do
# usuário. O app avisa em tela se detectar uma chave de serviço no ambiente.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Backend
#   auto     (padrão) usa o Supabase se houver URL + chave; senão, modo demo
#   supabase força o Supabase (falha alto se faltar credencial)
#   local    força o modo demonstração em SQLite
# -----------------------------------------------------------------------------
DIARIO_BACKEND=auto

# Caminho do banco do modo demonstração (relativo à raiz do projeto).
DIARIO_DB_PATH=data/diario_demo.db
